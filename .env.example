# ===== 会话密钥（部署前务必换成随机值：openssl rand -base64 48）=====
AUTH_SECRET=please-change-me-to-a-long-random-string

# ===== 数据库（MySQL 8）=====
# 库要先自己建好，脚本只建表：
#   CREATE DATABASE ling_xiu_ai DEFAULT CHARSET utf8mb4 COLLATE utf8mb4_unicode_ci;
# 建表： npm run db:init
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=ling_xiu_ai
# 连接池上限，默认 10。库在外网、又和别的应用共用时，别调太高
# MYSQL_POOL=10

# ===== AI 供应商（OpenAI 兼容协议，换供应商只改这三项）=====
AI_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
AI_API_KEY=sk-xxxxxxxx

# 主模型：引导式教练对话（质量优先）。实测 deepseek-v4-pro 约 33 秒、质量最佳；
# qwen3.8-max 质量相近但要 100 秒以上（推理耗时长），故不作默认。
AI_MODEL=deepseek-v4-pro
# 快模型：负责结构化抽取等批量任务（成本优先）
AI_MODEL_FAST=deepseek-v4.1-flash
# 文生图模型：经文的意境配图（留空则关闭该功能）。可选 wan2.7-image-pro
AI_MODEL_IMAGE=wan2.7-image
# 文生图端点。默认按 AI_BASE_URL 推导出多模态生成端点，
# 因为这套服务上 /images/generations 与原生 text2image 都回 "url error"，
# 异步提交也被拒，只有多模态生成端点能同步出图（约 15 秒）。换供应商时才需要改。
# AI_IMAGE_URL=https://.../api/v1/services/aigc/multimodal-generation/generation
# ===== 语音转文字（口述笔记）=====
# 用上面的 AI_API_KEY 就能转写，不必另配服务，以下几项一般都不用填。
#
# 这套服务的转写能力藏在 realtime 模型里，HTTP 那几条路都不通：
#   /audio/transcriptions 回 "Model not exist"；
#   /chat/completions 和多模态端点传音频只回一个空壳 {"status_message":"Success."}。
# 只有 realtime 的 WebSocket 会吐转写事件，实测 5.5 秒中文音频 1.1 秒出结果。
# 地址默认按 AI_BASE_URL 的主机推导成 wss://<host>/api-ws/v1/realtime。
#
# 另外需要服务器装 ffmpeg：浏览器只能录 opus/aac，
# 而识别端只吃 16kHz 单声道 PCM16，靠 ffmpeg 在内存里转一道（不落盘）。
# AI_ASR_MODEL=qwen-audio-3.0-realtime-plus   # realtime 会话用的模型
# AI_ASR_ENGINE=gummy-realtime-v1             # 会话里真正干转写活的模型
# AI_ASR_WS_URL=wss://.../api-ws/v1/realtime  # 换供应商时才需要覆盖
# AI_ASR_BASE_URL=                            # 留空沿用 AI_BASE_URL
# AI_ASR_API_KEY=                             # 留空沿用 AI_API_KEY

# ===== 灵修流程参数 =====
# 解锁"引导揭晓"所需的最低总分（0-100）
DEVOTION_UNLOCK_SCORE=60
# 每日默认读经章数
DAILY_CHAPTERS=4
