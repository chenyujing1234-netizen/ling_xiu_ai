# ===== 会话密钥（部署前务必换成随机值：openssl rand -base64 48）=====
AUTH_SECRET=please-change-me-to-a-long-random-string

# ===== AI 供应商（OpenAI 兼容协议，换供应商只改这三项）=====
AI_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
AI_API_KEY=sk-xxxxxxxx

# 主模型：引导式教练对话（质量优先）。实测 deepseek-v4-pro 约 33 秒、质量最佳；
# qwen3.8-max 质量相近但要 100 秒以上（推理耗时长），故不作默认。
AI_MODEL=deepseek-v4-pro
# 快模型：负责结构化抽取等批量任务（成本优先）
AI_MODEL_FAST=deepseek-v4.1-flash
# 文生图模型：经文的意境配图（留空则关闭该功能）。可选 wan2.7-image-pro
AI_MODEL_IMAGE=wan2.7-image
# 文生图端点。默认按 AI_BASE_URL 推导出多模态生成端点，
# 因为这套服务上 /images/generations 与原生 text2image 都回 "url error"，
# 异步提交也被拒，只有多模态生成端点能同步出图（约 15 秒）。换供应商时才需要改。
# AI_IMAGE_URL=https://.../api/v1/services/aigc/multimodal-generation/generation
# 语音转写模型（留空则录音只存音频、不自动转文字）
AI_MODEL_AUDIO=qwen-audio-3.0-realtime-plus

# ===== 灵修流程参数 =====
# 解锁"引导揭晓"所需的最低总分（0-100）
DEVOTION_UNLOCK_SCORE=60
# 每日默认读经章数
DAILY_CHAPTERS=4
